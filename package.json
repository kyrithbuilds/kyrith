{
  "name": "kyrithbuilds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-favicons": "node scripts/copy-favicons.mjs",
    "predev": "npm run copy-favicons",
    "prebuild": "npm run copy-favicons",
    "dev": "vite",
    "dev:with-php": "npm run copy-favicons && concurrently -k -n vite,php -c blue,magenta \"vite\" \"node scripts/php-server.mjs\"",
    "start": "npm run dev:with-php",
    "build": "vite build",
    "pack-upload": "vite build && node scripts/package-for-hosting.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  }
}
