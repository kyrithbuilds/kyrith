# KyrithBuilds — shared hosting (Apache / cPanel)
# Copied to /dist on `npm run build` — upload with the rest of the frontend.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pre-rendered pages: /services → services.html, /blog → blog.html (written by scripts/prerender.mjs).
  # Must come before the file/folder rule: /blog is also a folder (it holds /blog/<post>.html).
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Serve real files and folders as-is (includes /api/contact.php and /assets/*)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router (client-side routes) → SPA shell
  RewriteRule . /index.html [L]
</IfModule>
